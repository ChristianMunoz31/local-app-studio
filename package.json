{
  "name": "local-app-studio",
  "private": true,
  "version": "1.1.1",
  "description": "Local App Studio - a local-first desktop app.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristianMunoz31/local-app-studio.git"
  },
  "bugs": {
    "url": "https://github.com/ChristianMunoz31/local-app-studio/issues"
  },
  "homepage": "https://github.com/ChristianMunoz31/local-app-studio#readme",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "start": "node --import ./scripts/lib/proHook.js server.js",
    "build": "vite build",
    "postbuild": "node scripts/license/writeBuildInfo.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "node scripts/visualUpdate.js",
    "import": "node scripts/import.js",
    "eval:ai": "node scripts/lib/proRun.js scripts/evalAi.js",
    "prepare": "node scripts/installHooks.js",
    "check": "npm run check:em-dash && npm run check:personal && npm run check:keys && npm run check:workflows && npm run check:pro-marker -- --require-present --source",
    "check:em-dash": "node scripts/checks/noEmDash.js",
    "check:personal": "node scripts/checks/personalData.js",
    "check:keys": "node scripts/checks/noPrivateKeys.js",
    "check:workflows": "node scripts/ci/workflowCheck.js",
    "check:store-config": "node scripts/lib/proRun.js scripts/checks/storeConfig.js",
    "check:bundle": "node scripts/checks/bundleBudget.js",
    "check:sidecar": "node scripts/checks/sidecarBudget.js",
    "check:pro-marker": "node scripts/checks/proMarker.js",
    "check:public": "node scripts/checks/publicBuild.js",
    "check:cloud-marker": "node scripts/checks/cloudMarker.js",
    "gate": "node scripts/ci/gate.js",
    "phase:gate": "node scripts/phase/gate.js",
    "phase:cleanup": "node scripts/phase/cleanup.js",
    "doctor": "node --import ./scripts/lib/proHook.js scripts/doctor.js",
    "debug:e2e": "node scripts/debugE2e.js",
    "seed:demo": "node scripts/seedDemo.js",
    "sandbox": "node scripts/sandbox.js",
    "sandbox:reset": "node scripts/sandbox.js --reset",
    "preview:branch": "node scripts/previewBranch.js",
    "preview:clean": "node scripts/previewBranch.js --clean",
    "fake:ollama": "node scripts/fakeOllama.js",
    "dev:refresh": "node scripts/devRefresh.js",
    "desktop:sidecar": "node scripts/desktop/buildSidecar.js --minify",
    "desktop:dev": "node scripts/desktop/dev.js",
    "desktop:build": "node scripts/lib/proRun.js scripts/desktop/build.js",
    "desktop:build:dev": "node scripts/desktop/buildDev.js",
    "desktop:icons": "node scripts/desktop/icons.js",
    "init-app": "node scripts/init-app.mjs",
    "package:kit": "node scripts/package-kit.mjs",
    "template:package": "node scripts/lib/proRun.js scripts/packageTemplate.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.20",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^7.0.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.1",
    "@use-gesture/react": "^10.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fast-deep-equal": "^3.1.3",
    "fflate": "^0.8.3",
    "he-tree-react": "^1.3.1",
    "immer": "^11.2.9",
    "lucide-react": "^1.50.0",
    "node-fetch": "^3.3.1",
    "object-hash": "^3.0.0",
    "react": "^19.3.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^4.1.2",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^7.18.4",
    "react-zoom-pan-pinch": "^4.2.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1",
    "unpdf": "1.8.1",
    "zod": "^4.6.7",
    "zundo": "^2.3.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/object-hash": "^3.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "acorn": "^8.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "postject": "^1.0.0-alpha.6",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
