{
 "specVersion": 1,
 "app": {
  "name": "Crew Board",
  "slug": "crew-board",
  "identifier": "com.example.crewboard",
  "version": "1.0.0",
  "description": "For a small trade business that plans who works on which crew and who leads it.",
  "icon": "users"
 },
 "tables": [
  {
   "id": "crews",
   "label": "Crews",
   "titleField": "name",
   "fields": [
    {
     "id": "name",
     "label": "Name",
     "type": "text",
     "required": true
    },
    {
     "id": "area",
     "label": "Area",
     "type": "select",
     "options": [
      "North",
      "South",
      "East",
      "West"
     ]
    },
    {
     "id": "status",
     "label": "Status",
     "type": "select",
     "options": [
      "Active",
      "Paused"
     ],
     "default": "Active"
    }
   ]
  },
  {
   "id": "people",
   "label": "People",
   "titleField": "name",
   "fields": [
    {
     "id": "name",
     "label": "Name",
     "type": "text",
     "required": true
    },
    {
     "id": "role",
     "label": "Role",
     "type": "select",
     "options": [
      "Lead",
      "Crew",
      "Apprentice"
     ],
     "default": "Crew"
    },
    {
     "id": "crew",
     "label": "Crew",
     "type": "reference",
     "table": "crews"
    },
    {
     "id": "available",
     "label": "Available",
     "type": "boolean",
     "default": true
    },
    {
     "id": "started",
     "label": "Started",
     "type": "date"
    }
   ]
  }
 ],
