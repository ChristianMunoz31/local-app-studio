       "fields": [
        "status",
        "area"
       ],
       "submitLabel": "Save crew"
      },
      "children": []
     }
    ]
   }
  }
 ],
 "nav": [
  {
   "pageId": "home",
   "label": "People",
   "icon": "users"
  },
  {
   "pageId": "crews",
