    {
     "id": "people_all",
     "table": "people",
     "orderBy": [
      {
       "field": "name",
       "dir": "asc"
      }
     ]
    }
   ],
   "layout": {
    "id": "r",
    "type": "Page",
    "props": {},
    "children": [
     {
      "id": "h1",
      "type": "PageHeader",
      "props": {
       "title": "People"
      },
      "children": [
       {
        "id": "b1",
        "type": "Button",
        "props": {
         "action": {
          "action": "open-form",
          "table": "people",
          "mode": "create"
         }
        },
        "children": "Add person"
       }
      ]
     },
     {
      "id": "fb",
      "type": "FilterBar",
      "props": {
       "source": "people_all",
       "fields": [
        "crew",
        "role",
        "available"
       ]
      },
      "children": []
     },
     {
      "id": "t1",
      "type": "DataTable",
      "props": {
       "source": "people_all",
       "columns": [
        "name",
        "role",
        "crew",
        "available",
        "started"
       ]
      },
      "children": []
     }
    ]
   }
  },
  {
   "id": "crews",
   "title": "Crews",
   "route": "/crews",
   "sources": [
    {
     "id": "crews_all",
     "table": "crews",
     "orderBy": [
      {
       "field": "name",
       "dir": "asc"
      }
     ]
    }
   ],
   "layout": {
    "id": "r",
    "type": "Page",
    "props": {},
    "children": [
     {
      "id": "h1",
      "type": "PageHeader",
      "props": {
       "title": "Crews"
      },
      "children": [
       {
