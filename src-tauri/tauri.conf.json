{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Local App Studio",
  "version": "../package.json",
  "mainBinaryName": "LocalAppStudio",
  "identifier": "com.neuralfoundry.localappstudio",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Local App Studio",
    "shortDescription": "Private, local-first desktop app",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/local-app-studio-server"],
    "resources": ["resources/dist", "resources/migrations"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
